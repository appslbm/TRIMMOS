---
/**
 * URL antiga /services.html — mantida para não quebrar links já compartilhados.
 * Redireciona para o site (a seção de serviços foi removida; o agendamento fica no aplicativo).
 */
import { path, site } from '../lib/site';

const target = path('inicio.html');
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.business.name}</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(target, import.meta.env.SITE ?? site.deploy.site).href} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <script is:inline define:vars={{ target }}>location.replace(target);</script>
  </head>
  <body>
    <p><a href={target}>Ir para o site da {site.business.name}</a></p>
  </body>
</html>
