---
/**
 * Site da barbearia (vitrine). URL preservada: /inicio.html
 * A ordem das seções segue a jornada de quem chega pelo celular querendo agendar:
 * quem atende → o que dizem → trabalhos → quem somos → onde fica.
 * Serviços e preços ficam no aplicativo de agendamento (links no topo, no menu e na barra do celular).
 */
import About from '../components/About.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import Gallery from '../components/Gallery.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Location from '../components/Location.astro';
import MobileBar from '../components/MobileBar.astro';
import Reviews from '../components/Reviews.astro';
import Showcase from '../components/Showcase.astro';
import Team from '../components/Team.astro';
import Base from '../layouts/Base.astro';
import { site } from '../lib/site';

const nav = [
  ...(site.team.length ? [{ href: '#equipe', label: 'Equipe' }] : []),
  { href: '#avaliacoes', label: 'Avaliações' },
  ...(site.showcase ? [{ href: '#estilos', label: 'Trabalhos' }] : []),
  { href: '#sobre', label: 'Sobre' },
  { href: '#localizacao', label: 'Localização' },
];
---

<Base title={site.seo.title} description={site.seo.description} canonicalPath="inicio.html" bodyClass="has-mobile-bar">
  <a href="#conteudo" class="skip-link">Pular para o conteúdo</a>
  <Header nav={nav} />
  <main id="conteudo">
    <Hero />
    <Team />
    <Reviews />
    <Showcase />
    <Gallery />
    <About />
    <Location />
    <FinalCta />
  </main>
  <Footer />
  <MobileBar />
</Base>
