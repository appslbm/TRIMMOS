---
import { formatRating, links, site } from '../lib/site';
import Icon from './Icon.astro';

const { reviews } = site;
const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((p) => p[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();
---

{
  (reviews.items.length > 0 || reviews.ratings.length > 0) && (
    <section class="section" id="avaliacoes" aria-labelledby="avaliacoes-title">
      <div class="container">
        <div class="reviews-head">
          <div class="section-head">
            <p class="eyebrow">Avaliações</p>
            <h2 id="avaliacoes-title">O que dizem nossos clientes</h2>
          </div>

          {reviews.ratings.length > 0 && (
            <ul class="ratings" role="list">
              {reviews.ratings.map((r) => {
                const label = `Nota ${formatRating(r.value)} de ${r.scale}`;
                const body = (
                  <>
                    <span class="rating__value">{formatRating(r.value)}</span>
                    <span class="rating__meta">
                      <span class="stars" role="img" aria-label={label}>
                        {Array.from({ length: 5 }, () => (
                          <Icon name="star" />
                        ))}
                      </span>
                      <span class="rating__source">
                        {r.scale === 10 ? 'de 10 · ' : ''}
                        {r.count ? `${r.count} avaliações no ${r.source}` : `no ${r.source}`}
                      </span>
                    </span>
                  </>
                );
                return (
                  <li>
                    {r.url ? (
                      <a class="rating" href={r.url} target="_blank" rel="noopener">
                        {body}
                      </a>
                    ) : (
                      <span class="rating">{body}</span>
                    )}
                  </li>
                );
              })}
            </ul>
          )}
        </div>

        {reviews.items.length > 0 && (
          <ul class="reviews" role="list" tabindex="0" aria-label="Avaliações de clientes (role para ver mais)">
            {reviews.items.map((r) => (
              <li class="review">
                <figure>
                  <span class="stars" role="img" aria-label={`${r.rating} de 5 estrelas`}>
                    {Array.from({ length: r.rating }, () => (
                      <Icon name="star" />
                    ))}
                  </span>
                  <blockquote>
                    <p>{r.text}</p>
                  </blockquote>
                  <figcaption>
                    <span class="review__avatar" aria-hidden="true">
                      {initials(r.author)}
                    </span>
                    {r.author}
                  </figcaption>
                </figure>
              </li>
            ))}
          </ul>
        )}

        <div class="reviews__actions">
          {links.reviews && (
            <a href={links.reviews} class="btn btn--secondary" target="_blank" rel="noopener">
              Ver avaliações no Google
              <Icon name="external" />
            </a>
          )}
          {links.writeReview && (
            <a href={links.writeReview} class="reviews__write" target="_blank" rel="noopener">
              Já é cliente? Deixe sua avaliação
            </a>
          )}
        </div>
      </div>
    </section>
  )
}

<style>
  .reviews-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--sp-4) var(--sp-6);
    margin-bottom: var(--sp-6);
  }

  .reviews-head .section-head {
    margin-bottom: 0;
  }

  .ratings {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3) var(--sp-6);
  }

  .rating {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    text-decoration: none;
  }

  a.rating:hover .rating__source {
    color: var(--text);
  }

  .rating__meta {
    display: grid;
    gap: 2px;
  }

  .rating__value {
    font-family: var(--font-display);
    font-size: 2.75rem;
    font-weight: 500;
    line-height: 1;
  }

  .rating .stars :global(.icon) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .rating__source {
    font-size: var(--fs-sm);
    color: var(--muted);
    transition: color 0.15s ease;
  }

  /* Celular: carrossel com rolagem nativa; desktop: grade */
  .reviews {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(85%, 22rem);
    gap: var(--sp-4);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    padding-bottom: var(--sp-3);
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    scroll-padding-inline: var(--gutter);
    scrollbar-width: thin;
  }

  .review {
    scroll-snap-align: start;
  }

  .review figure {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    height: 100%;
    padding: var(--sp-5);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .review blockquote {
    flex: 1;
    color: var(--text);
  }

  .review figcaption {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    font-weight: 600;
    font-size: var(--fs-sm);
  }

  .review__avatar {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
  }

  @media (min-width: 56rem) {
    .reviews {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, 1fr);
      overflow: visible;
      margin-inline: 0;
      padding-inline: 0;
    }
  }

  .reviews__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-4) var(--sp-6);
    margin-top: var(--sp-6);
  }

  .reviews__write {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: var(--fs-sm);
    color: var(--muted);
    text-underline-offset: 3px;
  }

  .reviews__write:hover {
    color: var(--text);
  }
</style>
