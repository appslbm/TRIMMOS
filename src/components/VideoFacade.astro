---
/**
 * Vídeo do YouTube que só carrega o player quando a pessoa toca no play.
 * Evita ~4 MB de JavaScript do YouTube no carregamento da página.
 * Sem JavaScript, o link abre o vídeo no YouTube.
 */
import Icon from './Icon.astro';

interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<div class="video">
  <a
    class="video__link"
    href={`https://www.youtube.com/watch?v=${id}`}
    target="_blank"
    rel="noopener"
    data-youtube-id={id}
    data-title={title}
  >
    <picture>
      <source srcset={`https://i.ytimg.com/vi_webp/${id}/hqdefault.webp`} type="image/webp" />
      <img
        src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`}
        alt=""
        width="480"
        height="360"
        loading="lazy"
        decoding="async"
        class="video__thumb"
      />
    </picture>
    <span class="video__play">
      <Icon name="play" />
    </span>
    <span class="visually-hidden">Assistir ao vídeo: {title}</span>
  </a>
</div>

<style>
  .video {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: #000;
  }

  .video__link,
  .video__thumb,
  .video :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video__link:focus-visible {
    outline-offset: -4px;
  }

  .video__thumb {
    object-fit: cover;
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }

  .video__link:hover .video__thumb {
    opacity: 1;
  }

  .video__play {
    position: absolute;
    inset: 0;
    margin: auto;
    display: grid;
    place-items: center;
    width: 4.25rem;
    height: 4.25rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--on-accent);
  }

  .video__play :global(.icon) {
    width: 1.75rem;
    height: 1.75rem;
    margin-left: 4px;
  }
</style>

<script>
  for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-youtube-id]')) {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${link.dataset.youtubeId}?autoplay=1&rel=0`;
      iframe.title = link.dataset.title ?? 'Vídeo';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      link.replaceWith(iframe);
      iframe.focus();
    });
  }
</script>
