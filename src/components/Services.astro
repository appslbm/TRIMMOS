---
import { allServices, featuredServices, formatDuration, formatPrice, links, site } from '../lib/site';
import Icon from './Icon.astro';

const featured = featuredServices.length ? featuredServices : allServices.slice(0, 6);
const hasMore = allServices.length > featured.length;
---

<section class="section" id="servicos" aria-labelledby="servicos-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Serviços</p>
      <h2 id="servicos-title">Serviços e preços</h2>
    </div>

    <ul class="services" role="list">
      {
        featured.map((s) => (
          <li>
            <a href={links.booking} class="service" target="_blank" rel="noopener">
              <span class="service__info">
                <span class="service__name">{s.name}</span>
                <span class="visually-hidden">, </span>
                {s.description && (
                  <>
                    <span class="visually-hidden">, </span>
                    <span class="service__desc">{s.description}</span>
                  </>
                )}
                <span class="service__meta">
                  <Icon name="clock" />
                  {formatDuration(s.duration)}
                </span>
              </span>
              <span class="visually-hidden">, </span>
              <span class="service__side">
                <span class="service__price">{formatPrice(s.price)}</span>
                <span class="visually-hidden"> — </span>
                <span class="service__cta">
                  Agendar
                  <Icon name="arrow" />
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    {
      hasMore && (
        <details class="all-services">
          <summary>
            <span>Ver todos os serviços e combos</span>
            <Icon name="chevron" class="all-services__chevron" />
          </summary>
          <div class="all-services__body">
            {site.services.categories.map((cat) => (
              <div class="price-group">
                <h3 class="price-group__title">{cat.name}</h3>
                <dl class="price-list">
                  {cat.items.map((s) => (
                    <div class="price-row">
                      <dt>
                        {s.name}
                        <span class="price-row__duration">{formatDuration(s.duration)}</span>
                      </dt>
                      <dd>{formatPrice(s.price)}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            ))}
          </div>
        </details>
      )
    }

    <div class="services__footer">
      {site.services.note && <p class="muted small">{site.services.note}</p>}
      <a href={links.booking} class="btn btn--primary" target="_blank" rel="noopener">
        <Icon name="calendar" />
        {site.booking.label}
      </a>
    </div>
  </div>
</section>

<style>
  .services {
    display: grid;
    gap: var(--sp-3);
  }

  .service {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    height: 100%;
    padding: var(--sp-4) var(--sp-5);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease;
  }

  .service:hover {
    background: var(--surface-2);
    border-color: var(--border-strong);
  }

  .service__info,
  .service__side {
    display: grid;
    gap: 2px;
  }

  .service__side {
    justify-items: end;
    text-align: right;
  }

  .service__name {
    font-size: var(--fs-lg);
    font-weight: 600;
    line-height: 1.3;
  }

  .service__desc {
    font-size: var(--fs-sm);
    color: var(--muted);
    line-height: 1.4;
  }

  .service__meta,
  .service__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-size: var(--fs-sm);
    color: var(--muted);
  }

  .service__meta .icon,
  .service__cta .icon {
    width: 1em;
    height: 1em;
  }

  .service__cta {
    font-weight: 600;
    color: var(--text);
  }

  .service:hover .service__cta {
    color: var(--accent);
  }

  .service__price {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1.2;
    color: var(--accent);
    white-space: nowrap;
  }

  @media (min-width: 40rem) {
    .services {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .services {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Lista completa */
  .all-services {
    margin-top: var(--sp-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .all-services summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    min-height: 3.5rem;
    padding: var(--sp-3) var(--sp-5);
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    border-radius: var(--radius-lg);
  }

  .all-services summary::-webkit-details-marker {
    display: none;
  }

  .all-services :global(.all-services__chevron) {
    color: var(--accent);
    transition: transform 0.2s ease;
  }

  .all-services[open] :global(.all-services__chevron) {
    transform: rotate(180deg);
  }

  .all-services__body {
    display: grid;
    gap: var(--sp-6);
    padding: var(--sp-2) var(--sp-5) var(--sp-5);
  }

  @media (min-width: 48rem) {
    .all-services__body {
      grid-template-columns: repeat(2, 1fr);
      column-gap: var(--sp-7);
    }
  }

  .price-group__title {
    font-size: var(--fs-sm);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--sp-2);
  }

  .price-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--sp-4);
    padding-block: var(--sp-3);
    border-bottom: 1px solid var(--border);
  }

  .price-row:last-child {
    border-bottom: 0;
  }

  .price-row dt {
    display: grid;
  }

  .price-row__duration {
    font-size: var(--fs-xs);
    color: var(--muted);
  }

  .price-row dd {
    white-space: nowrap;
    font-weight: 600;
  }

  .services__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    margin-top: var(--sp-6);
  }

  @media (max-width: 29.99rem) {
    .services__footer .btn {
      width: 100%;
    }
  }
</style>
