---
/**
 * "Estilos": cortes que a barbearia publica, cada card leva à publicação original.
 * O fundo laranja em degradê reproduz o fundo usado nas fotos de corte da marca,
 * sem copiar as fotos (que mostram clientes) para o site.
 */
import { links, site } from '../lib/site';
import Icon from './Icon.astro';

const showcase = site.showcase;
---

{
  showcase && (
    <section class="section" id="estilos" aria-labelledby="estilos-title">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Trabalhos</p>
          <h2 id="estilos-title">{showcase.title}</h2>
          {showcase.intro && <p class="lead">{showcase.intro}</p>}
        </div>

        <ul class="styles" role="list">
          {showcase.items.map((item) => (
            <li>
              <a class="style-card" href={item.url} target="_blank" rel="noopener">
                <span class="style-card__name">{item.name}</span>
                {item.alias && <span class="style-card__alias">ou “{item.alias}”</span>}
                {item.text && <span class="style-card__text">{item.text}</span>}
                <span class="style-card__link">
                  {showcase.linkLabel}
                  <Icon name="external" />
                </span>
              </a>
            </li>
          ))}
        </ul>

        {links.instagram && (
          <p class="styles__more">
            <a href={links.instagram} class="btn btn--secondary" target="_blank" rel="noopener">
              <Icon name="instagram" />
              Ver mais em {site.contact.instagramHandle ?? 'nosso Instagram'}
            </a>
          </p>
        )}
      </div>
    </section>
  )
}

<style>
  .styles {
    display: grid;
    gap: var(--sp-3);
  }

  @media (min-width: 34rem) {
    .styles {
      grid-template-columns: repeat(2, 1fr);
    }

    .style-card {
      min-height: 11rem;
    }
  }

  @media (min-width: 64rem) {
    .styles {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--sp-4);
    }
  }

  .style-card {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    height: 100%;
    padding: var(--sp-5);
    border-radius: var(--radius-lg);
    color: var(--on-accent);
    text-decoration: none;
    /* Fundo inspirado no estúdio laranja das fotos de corte da marca */
    background:
      radial-gradient(120% 90% at 50% 20%, color-mix(in oklab, var(--accent) 80%, white) 0%, transparent 60%),
      linear-gradient(160deg, var(--accent) 30%, color-mix(in oklab, var(--accent) 84%, black) 100%);
    transition: transform 0.2s ease;
  }

  .style-card:hover {
    transform: translateY(-2px);
  }

  .style-card__name {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.25rem);
    font-weight: 600;
    line-height: 1;
    text-transform: uppercase;
  }

  .style-card__alias {
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  .style-card__text {
    margin-top: var(--sp-2);
    font-size: var(--fs-sm);
    line-height: 1.45;
  }

  .style-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin-top: auto;
    padding-top: var(--sp-4);
    font-size: var(--fs-sm);
    font-weight: 700;
  }

  .style-card__link :global(.icon) {
    width: 1em;
    height: 1em;
  }

  .styles__more {
    margin-top: var(--sp-6);
  }

  @media (max-width: 29.99rem) {
    .styles__more .btn {
      width: 100%;
    }
  }
</style>
